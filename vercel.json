{
  "version": 2,
  "builds": [
    {
      "src": "api/records.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/sharepoint.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/sync.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/sharepoint(.*)", "dest": "/api/sharepoint.js" },
    { "src": "/api/sync(.*)", "dest": "/api/sync.js" },
    { "src": "/api/(.*)", "dest": "/api/records.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
